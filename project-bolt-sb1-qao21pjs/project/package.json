{
  "name": "hind-lms-portal",
  "private": true,
  "version": "1.0.0-rc",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter portal dev",
    "build": "pnpm --filter portal build",
    "preview": "pnpm --filter portal preview",
    "lint": "pnpm --filter \"*\" lint",
    "test": "pnpm --filter \"*\" test",
    "test:e2e": "pnpm --filter portal test:e2e",
    "storybook": "pnpm --filter design-system storybook",
    "clean": "pnpm --filter \"*\" clean && rm -rf node_modules",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter \"*\" typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.10.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "prettier": "^3.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^1.0.0"
  }
}